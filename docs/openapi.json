{
  "openapi": "3.0.4",
  "info": {
    "title": "ChatCommunicator REST API docs",
    "version": "in dev"
  },
  "paths": {
    "/api/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Authenticates user",
        "description": "Validates the provided login credentials. On success, returns a JWT access token and a refresh token.\r\nIf authentication fails, a detailed error is returned.",
        "requestBody": {
          "description": "The login credentials, including email and password.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User successfully authenticated. Tokens returned.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/LoggedUserDto"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoggedUserDto"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoggedUserDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid login request (e.g., malformed input)."
          },
          "401": {
            "description": "Invalid email or password."
          },
          "500": {
            "description": "An unexpected server error occurred."
          }
        }
      }
    },
    "/api/auth/refresh-token": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Refresh access token",
        "description": "Validates the provided refresh token and, if valid, issues a new access token and refresh token.",
        "requestBody": {
          "description": "The DTO containing the refresh token.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshTokenDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshTokenDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshTokenDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Access token successfully refreshed.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/RefreshAccessTokenDto"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RefreshAccessTokenDto"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/RefreshAccessTokenDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid or malformed refresh token."
          },
          "401": {
            "description": "Unauthorized or expired refresh token."
          },
          "500": {
            "description": "An unexpected server error occurred."
          }
        }
      }
    },
    "/api/chats": {
      "get": {
        "tags": [
          "Chats"
        ],
        "summary": "Get chats",
        "description": "Requires a valid JWT token in the Authorization header. The user's ID is extracted\r\nfrom the token claims and used to fetch chat data.\r\n            \r\nReturns 401 Unauthorized if the user ID is missing or invalid.\r\nReturns appropriate error responses for validation failures or internal errors.",
        "responses": {
          "200": {
            "description": "List of chats successfully retrieved.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ChatDto"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ChatDto"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ChatDto"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or validation error."
          },
          "401": {
            "description": "Unauthorized – missing or invalid JWT token."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    },
    "/api/chats/{conversationId}/messages": {
      "get": {
        "tags": [
          "Chats"
        ],
        "summary": "Get a paginated list of messages",
        "description": "This endpoint returns a paginated list of messages for a given conversation.\r\nIf `fromMessageId` is provided, it returns messages after that ID.\r\nIf `fromMessageId` is null, it returns an empty list (with 200 OK).\r\nRequires a valid JWT token in the Authorization header.\r\nIf `conversationId` is missing, empty, or invalid, an error response is returned.\r\n\r\n\r\n\r\nIf messages are successfully retrieved and both the recipient is online\r\n(has active connections) and there's a last read message ID from the friend,\r\na SignalR notification is sent to the recipient with the MessageRead event containing\r\nthe last read message ID.",
        "parameters": [
          {
            "name": "conversationId",
            "in": "path",
            "description": "The ID of the conversation (GUID). Required.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "fromMessageId",
            "in": "query",
            "description": "The ID of the message after which to start fetching (GUID). Optional.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved the paged messages (can be empty if `fromMessageId` is null).",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/PagedMessagesDto"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PagedMessagesDto"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/PagedMessagesDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or validation error."
          },
          "401": {
            "description": "Unauthorized – missing or invalid JWT token."
          },
          "404": {
            "description": "Conversation not found or access denied."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    },
    "/api/friend-invitations": {
      "post": {
        "tags": [
          "FriendInvitations"
        ],
        "summary": "Send Invite",
        "description": "Allows an authenticated user to send a friend invitation by providing the sender's and recipient's GUIDs.\r\nReturns a ChatCommunicator.Contracts.Dtos.Friendships.SendInviteDto object containing the invitation ID on success, or an error response on failure.",
        "requestBody": {
          "description": "Invitation data including sender and recipient GUIDs.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InviteDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/InviteDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/InviteDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Invitation sent successfully. Returns ChatCommunicator.Contracts.Dtos.Friendships.SendInviteDto.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/SendInviteDto"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SendInviteDto"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/SendInviteDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid invitation data (e.g., malformed or missing GUIDs)."
          },
          "401": {
            "description": "Unauthorized - JWT token required."
          },
          "404": {
            "description": "Recipient user not found."
          },
          "409": {
            "description": "Conflict (e.g., invitation already exists)."
          },
          "500": {
            "description": "Unexpected server error."
          }
        }
      }
    },
    "/api/friend-invitations/{friendInvitationId}/decline": {
      "post": {
        "tags": [
          "FriendInvitations"
        ],
        "summary": "Decline Invite",
        "description": "Allows an authenticated user to decline a friend invitation by providing the invitation ID, sender and recipient GUIDs.\r\nReturns appropriate errors if the invitation is invalid, already handled, or missing.",
        "parameters": [
          {
            "name": "friendInvitationId",
            "in": "path",
            "description": "The unique identifier of the friend invitation to decline.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "description": "Invitation data with sender and recipient GUIDs.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InviteDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/InviteDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/InviteDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Invitation declined successfully."
          },
          "400": {
            "description": "Invalid data (e.g., malformed GUIDs)."
          },
          "401": {
            "description": "Unauthorized - JWT token required."
          },
          "404": {
            "description": "Invitation not found or already declined."
          },
          "500": {
            "description": "Unexpected server error."
          }
        }
      },
      "patch": {
        "tags": [
          "FriendInvitations"
        ],
        "summary": "Decline Invite",
        "description": "Allows an authenticated user to decline a friend invitation by providing the invitation ID, sender and recipient GUIDs.\r\nReturns appropriate errors if the invitation is invalid, already handled, or missing.",
        "parameters": [
          {
            "name": "friendInvitationId",
            "in": "path",
            "description": "The unique identifier of the friend invitation to decline.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "description": "Invitation data with sender and recipient GUIDs.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InviteDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/InviteDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/InviteDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Invitation declined successfully."
          },
          "400": {
            "description": "Invalid data (e.g., malformed GUIDs)."
          },
          "401": {
            "description": "Unauthorized - JWT token required."
          },
          "404": {
            "description": "Invitation not found or already declined."
          },
          "500": {
            "description": "Unexpected server error."
          }
        }
      }
    },
    "/api/friend-invitations/{friendInvitationId}/accept": {
      "post": {
        "tags": [
          "FriendInvitations"
        ],
        "summary": "Accept Friend Invitation",
        "description": "Allows an authenticated user to accept a friend invitation by providing the invitation ID, sender's and recipient's GUIDs.\r\nOn success, both users are added to each other's friend lists and a conversation is created between them.\r\nReturns an ChatCommunicator.Contracts.Dtos.Friendships.AcceptFriendshipInviteDto object containing the friendship ID and the conversation ID.\r\nReturns errors for invalid input, not found invitations, or conflicts (e.g., already friends).",
        "parameters": [
          {
            "name": "friendInvitationId",
            "in": "path",
            "description": "The unique identifier of the friend invitation to accept.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "description": "Invitation data including sender and recipient GUIDs.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InviteDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/InviteDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/InviteDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Invitation accepted; users are now friends and a conversation is created. Returns ChatCommunicator.Contracts.Dtos.Friendships.AcceptFriendshipInviteDto.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/AcceptFriendshipInviteDto"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AcceptFriendshipInviteDto"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/AcceptFriendshipInviteDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid data provided (e.g., malformed or missing GUIDs)."
          },
          "401": {
            "description": "Unauthorized - JWT token required."
          },
          "404": {
            "description": "Invitation not found."
          },
          "409": {
            "description": "Conflict - users already friends or invitation already accepted."
          },
          "500": {
            "description": "Unexpected server error."
          }
        }
      },
      "patch": {
        "tags": [
          "FriendInvitations"
        ],
        "summary": "Accept Friend Invitation",
        "description": "Allows an authenticated user to accept a friend invitation by providing the invitation ID, sender's and recipient's GUIDs.\r\nOn success, both users are added to each other's friend lists and a conversation is created between them.\r\nReturns an ChatCommunicator.Contracts.Dtos.Friendships.AcceptFriendshipInviteDto object containing the friendship ID and the conversation ID.\r\nReturns errors for invalid input, not found invitations, or conflicts (e.g., already friends).",
        "parameters": [
          {
            "name": "friendInvitationId",
            "in": "path",
            "description": "The unique identifier of the friend invitation to accept.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "description": "Invitation data including sender and recipient GUIDs.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InviteDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/InviteDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/InviteDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Invitation accepted; users are now friends and a conversation is created. Returns ChatCommunicator.Contracts.Dtos.Friendships.AcceptFriendshipInviteDto.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/AcceptFriendshipInviteDto"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AcceptFriendshipInviteDto"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/AcceptFriendshipInviteDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid data provided (e.g., malformed or missing GUIDs)."
          },
          "401": {
            "description": "Unauthorized - JWT token required."
          },
          "404": {
            "description": "Invitation not found."
          },
          "409": {
            "description": "Conflict - users already friends or invitation already accepted."
          },
          "500": {
            "description": "Unexpected server error."
          }
        }
      }
    },
    "/api/users": {
      "post": {
        "tags": [
          "Users"
        ],
        "summary": "Register user",
        "description": "This endpoint creates a new user using an email, username, and password. If the email already exists,\r\na conflict response is returned. On success, basic user data is returned.",
        "requestBody": {
          "description": "The registration data including email, username, and password.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User successfully created.",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/RegisteredDto"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegisteredDto"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegisteredDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid registration data (e.g., password policy not met)."
          },
          "409": {
            "description": "Email already exists."
          },
          "500": {
            "description": "An unexpected server error occurred."
          }
        }
      },
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "Get Users",
        "description": "Authenticated users can search for other users by username or display name.\r\nResults exclude users who are already friends with, or already invited by, the specified user.\r\nRequires a valid JWT token.",
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "description": "Optional text to search users by (e.g., username or display name).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "invitableFor",
            "in": "query",
            "description": "The GUID of the user for whom to find invitable users (required).",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Users retrieved successfully.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/UserToInviteDto"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/UserToInviteDto"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/UserToInviteDto"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request (e.g., missing or malformed 'invitableFor' GUID)."
          },
          "401": {
            "description": "Unauthorized - JWT token missing or invalid."
          },
          "500": {
            "description": "Unexpected server error."
          }
        }
      }
    },
    "/api/users/{userId}/username": {
      "patch": {
        "tags": [
          "Users"
        ],
        "summary": "Change Username",
        "description": "Authenticated users can change their username. The new username must be unique.",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "description": "The ID of the user whose username is to be changed (from query).",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "description": "The new username to assign (from body).",
          "content": {
            "application/json": {
              "schema": {
                "type": "string"
              }
            },
            "text/json": {
              "schema": {
                "type": "string"
              }
            },
            "application/*+json": {
              "schema": {
                "type": "string"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Username successfully updated.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              },
              "application/json": {
                "schema": {
                  "type": "string"
                }
              },
              "text/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Invalid or missing username."
          },
          "401": {
            "description": "User is not authenticated or token is invalid."
          },
          "409": {
            "description": "The username is already taken."
          },
          "500": {
            "description": "An unexpected server error occurred."
          }
        }
      }
    },
    "/api/users/{userId}/password": {
      "patch": {
        "tags": [
          "Users"
        ],
        "summary": "Change Password",
        "description": "Authenticated users can change their password by providing the old password and a new password.\r\nThe new password must meet the required criteria.",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "description": "The ID of the user whose password is to be changed (from query).",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "description": "The DTO containing the old and new passwords.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePasswordDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePasswordDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePasswordDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Password successfully changed."
          },
          "400": {
            "description": "Invalid input (e.g., missing user ID, invalid old or new password)."
          },
          "401": {
            "description": "User is not authenticated, token is invalid, or old password is incorrect."
          },
          "500": {
            "description": "An unexpected server error occurred."
          }
        }
      }
    },
    "/api/users/{userId}/avatar": {
      "post": {
        "tags": [
          "Users"
        ],
        "summary": "Upload Avatar",
        "description": "Authenticated users can upload a new avatar image.\r\n\r\nThe uploaded file must meet the following requirements:\r\n<ul><li>Maximum file size: 5 MB</li><li>Maximum dimensions: 500x500 pixels</li><li>Supported formats: JPEG, PNG, etc.</li></ul>\r\n<b>Note:</b> The `userId` parameter is required and should be provided as a query parameter (e.g., `?userId=...`).",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "description": "The ID of the user uploading the avatar (from query).",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "required": [
                  "file"
                ],
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              },
              "encoding": {
                "file": {
                  "style": "form"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Avatar successfully uploaded and URL returned.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              },
              "application/json": {
                "schema": {
                  "type": "string"
                }
              },
              "text/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Invalid file (e.g., empty, too big, wrong format, too large, too small)."
          },
          "401": {
            "description": "User is not authenticated or token is invalid."
          },
          "404": {
            "description": "User not found in the system."
          },
