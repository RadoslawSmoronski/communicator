  "components": {
    "schemas": {
      "ChangePasswordRequest": {
        "required": [
          "newPassword",
          "oldPassword"
        ],
        "type": "object",
        "properties": {
          "oldPassword": {
            "maxLength": 50,
            "minLength": 6,
            "type": "string"
          },
          "newPassword": {
            "maxLength": 50,
            "minLength": 6,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "ChangeUsernameRequest": {
        "required": [
          "newUsername"
        ],
        "type": "object",
        "properties": {
          "newUsername": {
            "maxLength": 25,
            "minLength": 3,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "ConfirmEmailRequest": {
        "required": [
          "confirmationToken",
          "userId"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "confirmationToken": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "GetChatsResponse": {
        "type": "object",
        "properties": {
          "friendId": {
            "type": "string",
            "format": "uuid"
          },
          "friendUsername": {
            "type": "string",
            "nullable": true
          },
          "conversationId": {
            "type": "string",
            "format": "uuid"
          },
          "friendAvatarUrl": {
            "type": "string",
            "nullable": true
          },
          "friendshipId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "lastMessageId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "lastMessageContent": {
            "type": "string",
            "nullable": true
          },
          "isFriendSenderMessage": {
            "type": "boolean"
          },
          "lastMessageTimestamp": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "GetFriendshipInvitationResponse": {
        "type": "object",
        "properties": {
          "friendInvitationId": {
            "type": "string",
            "format": "uuid"
          },
          "senderId": {
            "type": "string",
            "format": "uuid"
          },
          "senderUsername": {
            "type": "string",
            "nullable": true
          },
          "senderAvatarUrl": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "GetUsersResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "username": {
