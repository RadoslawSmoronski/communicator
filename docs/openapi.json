      "delete": {
        "tags": [
          "Users"
        ],
        "summary": "Delete Avatar",
        "description": "Authenticated users can delete their avatar.\r\n\r\nThis action removes the avatar associated with the user account.\r\n\r\n\r\n<b>Note:</b> The `userId` parameter is required and should be provided as a query parameter (e.g., `?userId=...`).",
