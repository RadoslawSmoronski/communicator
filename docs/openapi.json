            "description": "The ID of the user whose avatar is to be deleted (from query).",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Avatar successfully deleted.",
