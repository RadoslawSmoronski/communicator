        "tags": [
          "Users"
        ],
        "summary": "Get user's chats",
        "description": "Route: GET api/users/{userId}/chats\r\nAuthorization: Required.\r\nQuery parameters:\r\n  - onlyFriends: bool",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
